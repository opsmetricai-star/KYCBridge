# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser. Used for admin payment approval.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (server only; the code falls back across models if one is overloaded)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Comma separated emails allowed to approve payments in /admin
ADMIN_EMAILS=

# Selar payment links (public)
NEXT_PUBLIC_SELAR_STARTER_URL=https://selar.com/47plan?currency=USD
NEXT_PUBLIC_SELAR_GROWTH_URL=https://selar.com/57plan?currency=USD
NEXT_PUBLIC_SELAR_SCALE_URL=https://selar.com/97plan?currency=USD

NEXT_PUBLIC_SITE_URL=http://localhost:3000
